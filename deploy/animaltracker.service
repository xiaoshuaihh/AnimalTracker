[Unit]
Description=AnimalTracker Campus Wildlife (self-hosted)
After=network.target

[Service]
Type=simple
User=animaltracker
WorkingDirectory=/opt/animaltracker
# 所有环境变量建议放在 .env（脚本会自动加载）；也可直接写在这里。
# WILDLIFE_DATA_DIR：数据库与图片的持久化目录（服务用户需有写权限）
# WILDLIFE_HOST：0.0.0.0 直接对外，或 127.0.0.1 配合 Nginx/Caddy 反代
# EVENT_ADMIN_USERNAMES：核心管理员用户名（逗号分隔）
EnvironmentFile=/opt/animaltracker/.env
ExecStart=/usr/bin/node scripts/dev.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
